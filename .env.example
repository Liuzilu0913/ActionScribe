# Groq Cloud API. Create a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-20b

# Optional: Notion integration. Leave both blank to skip task creation.
NOTION_API_KEY=
NOTION_DATABASE_ID=

# Optional: Slack Incoming Webhook. Leave blank to skip notifications.
SLACK_WEBHOOK_URL=

# Streamlit frontend -> FastAPI backend
BACKEND_URL=http://localhost:8000

# Application logging
APP_ENV=development
LOG_LEVEL=INFO
