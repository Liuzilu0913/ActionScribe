# Groq Cloud API. Create a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-20b

# Optional: Feishu Bitable task records. Create a custom app in the Feishu Open Platform,
# enable Bitable record creation, and grant it access to the target Base/table.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=

# Bitable column names. Create text columns for labels/date/review/source and number
# columns for the three scores, or change these names to match your table.
FEISHU_FIELD_TASK=任务
FEISHU_FIELD_OWNER=负责人
FEISHU_FIELD_DEADLINE=截止日期
FEISHU_FIELD_PRIORITY=优先级
FEISHU_FIELD_PRIORITY_SCORE=优先级分数
FEISHU_FIELD_URGENCY_SCORE=紧急度分数
FEISHU_FIELD_IMPACT_SCORE=影响度分数
FEISHU_FIELD_NEEDS_REVIEW=需要复核
FEISHU_FIELD_SOURCE_EXCERPT=原文摘录

# Optional: Feishu group custom-bot webhook. If signature verification is enabled,
# set the matching secret. Set a keyword if the bot requires a custom keyword.
FEISHU_BOT_WEBHOOK_URL=
FEISHU_BOT_SECRET=
FEISHU_BOT_KEYWORD=

# Streamlit frontend -> FastAPI backend
BACKEND_URL=http://localhost:8000

# Application logging
APP_ENV=development
LOG_LEVEL=INFO
