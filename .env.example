# ─────────────────────────────────────────────
# OpenAI (REQUIRED)
# https://platform.openai.com/api-keys
# ─────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-your-key-here

# Model configuration (gpt-4o recommended, gpt-4o-mini is cheaper)
OPENAI_MODEL=gpt-4o

# ─────────────────────────────────────────────
# Notion Integration (REQUIRED for task creation)
# Steps:
#   1. Go to https://www.notion.so/my-integrations
#   2. Create a new integration → copy "Internal Integration Token"
#   3. Share your database with the integration
#   4. Copy your Database ID from the Notion page URL
#
# Notion Database MUST have these properties:
#   - Task Name  (title type)
#   - Owner      (rich_text type)
#   - Deadline   (date type)
#   - Priority   (rich_text type)
#   - Priority Score (number type)
# ─────────────────────────────────────────────
NOTION_API_KEY=secret_your-notion-key-here
NOTION_DATABASE_ID=your-database-id-here

# ─────────────────────────────────────────────
# Slack Webhook (REQUIRED for notifications)
# Steps:
#   1. Go to https://api.slack.com/apps
#   2. Create App → "Incoming Webhooks" → Enable → Add to workspace
#   3. Select channel → Copy Webhook URL below
# ─────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXXXX/XXXXX/XXXXX

# ─────────────────────────────────────────────
# Application Settings
# ─────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# Backend URL used by Streamlit to call FastAPI
# When running locally (not Docker): http://localhost:8000
# When running via Docker Compose:   http://backend:8000
BACKEND_URL=http://localhost:8000
